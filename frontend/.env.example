# Nova frontend environment variables
# Copy this file to .env.local and adjust if you deploy your own contract.
# The values below point at the public deployed Nova contract on Stellar testnet.

# Deployed Nova crowdfunding contract
NEXT_PUBLIC_CONTRACT_ID=CCJ67UMBEM2NYCZM4DCPZN7HMVANZUUZAAAA2XEX7PHQL2UFKKNBQJD7

# Native XLM Stellar Asset Contract (testnet)
NEXT_PUBLIC_NATIVE_SAC=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# Soroban RPC + Horizon (testnet)
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Testnet network passphrase
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Any funded testnet account, used as the source for read-only simulations.
# Your deployer address works fine here.
NEXT_PUBLIC_READ_ACCOUNT=GCOSPT6LRYTI5ZQQCZDJMJ7GPLPOSBTMIT3VNDGYKYP2ZT7SKPDUW4NI

# Explorer base URLs
NEXT_PUBLIC_EXPLORER_TX=https://stellar.expert/explorer/testnet/tx
NEXT_PUBLIC_EXPLORER_CONTRACT=https://stellar.expert/explorer/testnet/contract